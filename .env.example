# Copy to .env. Nothing in .env is committed.

# Claude, the model that decides at each step
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox). Tick "Payouts" under
# the app's features. The business account behind the app needs a balance that covers the replay:
# 88 games x $115 CAD. docs/SANDBOX-SETUP.md walks through it.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYOUT_CURRENCY=CAD
# Webhook id from the dashboard, once the Render URL is registered. Without it events are applied unverified (local only).
PAYPAL_WEBHOOK_ID=

# Officials' PayPal addresses. Unset letters pay to official-<letter>@example.com, which PayPal
# holds as unclaimed. Set A, B and C to sandbox personal accounts to watch the money land.
OFFICIAL_A_EMAIL=
OFFICIAL_B_EMAIL=
OFFICIAL_C_EMAIL=

# Where the agent on duty (src/cli/watch.ts) reads the tournament document the scorer's app saves.
TOURNAMENT_URL=http://localhost:4173/api/tournament
# Where the ledger lives (the board, the watcher and the CLIs share it).
LEDGER=results/ledger.json
# The sandbox business account (the association); invoices are sent from it
PAYPAL_BUSINESS_EMAIL=
