{
  "name": "final-buzzer",
  "version": "0.1.0",
  "description": "Every official paid at the final buzzer. A youth basketball tournament's money, run by an agent on PayPal.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "board": "node --env-file=.env src/server.ts",
    "live": "node --env-file=.env src/cli/live.ts",
    "replay": "node --env-file=.env src/cli/replay.ts",
    "test": "node --test src/agent/guards.test.ts src/app/feed.test.ts src/agent/replan.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "node src/cli/check-claims.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@bryntum/scheduler": "npm:@bryntum/scheduler-trial@^7.3.8",
    "@modelcontextprotocol/sdk": "^1.6.1",
    "@paypal/mcp": "^1.8.1",
    "ag-grid-community": "^36.2.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
